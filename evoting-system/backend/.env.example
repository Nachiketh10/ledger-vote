# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
PORT=5000

# --- Neon PostgreSQL ---
# Get this from your Neon project dashboard -> Connection Details
# Must include ?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/evoting?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/evoting_test?sslmode=require

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-different-long-random-string

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Field-level encryption (face embeddings, PII) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Rate limiting ---
RATELIMIT_STORAGE_URI=memory://

# --- Face recognition ---
FACE_MATCH_THRESHOLD=0.55
FACE_REGISTRATION_SAMPLE_COUNT=20

# --- Fraud detection ---
MAX_FAILED_AUTH_ATTEMPTS=5
FRAUD_SCORE_BLOCK_THRESHOLD=70

# --- Uploads ---
UPLOAD_FOLDER=uploads
